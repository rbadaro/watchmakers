---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Page not found">
  <section class="content-wrap flex flex-col items-start py-24">
    <p class="text-sm font-medium numerals text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">
      This page is not on the map.
    </h1>
    <p class="mt-3 max-w-prose text-ink-dim">
      The maker or page you were looking for does not exist, or the address
      changed.
    </p>
    <a
      href={base}
      class="mt-6 rounded-full bg-accent px-4 py-2 text-sm font-medium text-white hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      Back to the index
    </a>
  </section>
</Base>
