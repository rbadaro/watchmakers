---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="content-wrap py-16">
    <h1 class="text-4xl font-semibold tracking-tight text-ink">
      Independent movement-makers, mapped.
    </h1>
    <p class="mt-3 max-w-prose text-ink-dim">
      A searchable index of the independent watchmakers behind the modern
      canon: tiers, scores, prices, and how their books actually work.
    </p>

    {/* The browse island (search, filters, card grid) mounts here in M3. */}
    <div
      id="browse-root"
      class="mt-10 rounded-card border border-hairline bg-surface shadow-card p-10 text-center text-ink-dim"
      aria-label="Maker index"
    >
      <p class="text-sm">The maker index is being assembled. Check back soon.</p>
    </div>
  </section>
</Base>
